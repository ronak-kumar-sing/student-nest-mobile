# Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app: never put secrets here.
# mock = in-memory mock backend, http = real API
EXPO_PUBLIC_API_MODE=http
# iOS simulator: localhost. Android emulator: use 10.0.2.2 instead of localhost (e.g. http://10.0.2.2:3000 and 10.0.2.2:9099).
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
EXPO_PUBLIC_FIREBASE_PROJECT_ID=student-nest-dev
# Any non-empty string works against the Auth emulator.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
